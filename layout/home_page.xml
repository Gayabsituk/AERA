<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5">

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/homepageBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Welcome Text ("Breathe easy,") -->
            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_extrabold"
                android:text="@string/welcome_Text"
                android:textColor="#6B7280"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- User Name ("Hev Abi") -->
            <TextView
                android:id="@+id/nameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_semibold"
                android:text="@string/hev_abi"
                android:textColor="#1A202C"
                android:textSize="24sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/welcomeText" />

            <!-- Offline Badge -->
            <TextView
                android:id="@+id/offlineBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_background"
                android:backgroundTint="#DDF0E3"
                android:fontFamily="@font/figtree_bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="OFFLINE"
                android:textColor="#264F36"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@+id/nameText"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/welcomeText" />

            <!-- The Statistics Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/statsCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/nameText"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/co2ProgressRing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:progress="89"
                        app:indicatorColor="#B71C1C"
                        app:indicatorSize="180dp"
                        app:layout_constraintBottom_toTopOf="@+id/warningIcon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:trackColor="#E0E0E0"
                        app:trackThickness="12dp" />

                    <TextView
                        android:id="@+id/co2AmountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_extrabold"
                        android:text="@string/_13_39"
                        android:textColor="#1A202C"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@+id/co2LabelText"
                        app:layout_constraintEnd_toEndOf="@+id/co2ProgressRing"
                        app:layout_constraintStart_toStartOf="@+id/co2ProgressRing"
                        app:layout_constraintTop_toTopOf="@+id/co2ProgressRing"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/co2LabelText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_bold"
                        android:text="@string/kg_co2_today"
                        android:textColor="#718096"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/co2ProgressRing"
                        app:layout_constraintEnd_toEndOf="@+id/co2ProgressRing"
                        app:layout_constraintStart_toStartOf="@+id/co2ProgressRing"
                        app:layout_constraintTop_toBottomOf="@+id/co2AmountText" />

                    <ImageView
                        android:id="@+id/warningIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_warning"
                        android:contentDescription="@string/warning_sign"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:tint="#B71C1C" />

                    <TextView
                        android:id="@+id/warningText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/figtree_extrabold"
                        android:text="@string/_11_of_daily_limit_remaining"
                        android:textColor="#B71C1C"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/warningIcon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/warningIcon"
                        app:layout_constraintTop_toTopOf="@+id/warningIcon" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Log Activity Header -->
            <TextView
                android:id="@+id/quickLogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/figtree_semibold"
                android:text="@string/quick_log_activity"
                android:textColor="#1A202C"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/statsCard" />

            <!-- Horizontal ScrollView for Category Buttons -->
            <HorizontalScrollView
                android:id="@+id/quickLogScroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/quickLogTitle">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Transport Button -->
                    <LinearLayout
                        android:layout_width="80dp"
                        android:layout_height="90dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/rounded_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_transport"
                            android:contentDescription="@string/transport_category"
                            app:tint="#2D6A4F" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/figtree_bold"
                            android:text="@string/transport"
                            android:textColor="#1A202C"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Energy Button -->
                    <LinearLayout
                        android:layout_width="80dp"
                        android:layout_height="90dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/rounded_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_energy"
                            android:contentDescription="@string/energy_category"
                            app:tint="#D97706" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/figtree_bold"
                            android:text="@string/energy"
                            android:textColor="#1A202C"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Food Button -->
                    <LinearLayout
                        android:layout_width="80dp"
                        android:layout_height="90dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/rounded_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_food"
                            android:contentDescription="@string/food_category"
                            app:tint="#3730A3" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/figtree_bold"
                            android:text="@string/food"
                            android:textColor="#1A202C"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Shopping Button -->
                    <LinearLayout
                        android:layout_width="80dp"
                        android:layout_height="90dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/rounded_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_shopping"
                            android:contentDescription="@string/shopping_category"
                            app:tint="#7C3AED" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/figtree_bold"
                            android:text="@string/shopping"
                            android:textColor="#1A202C"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Waste Button -->
                    <LinearLayout
                        android:layout_width="80dp"
                        android:layout_height="90dp"
                        android:background="@drawable/rounded_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_waste"
                            android:contentDescription="@string/waste_category"
                            app:tint="#4B5563" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/figtree_bold"
                            android:text="@string/waste"
                            android:textColor="#1A202C"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Tip Card (Food Advice) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tipCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/quickLogScroll"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Food Tag Badge -->
                    <TextView
                        android:id="@+id/tipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_background"
                        android:fontFamily="@font/figtree_bold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/food1"
                        android:textColor="#7F1D1D"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Leaf Icon -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_activity"
                        android:contentDescription="@string/leaf_icon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#7F1D1D" />

                    <!-- Tip Description -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/figtree_medium"
                        android:text="@string/foodDesc"
                        android:textColor="#4B5563"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tipTag" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>