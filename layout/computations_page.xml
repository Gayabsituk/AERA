<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5">

    <FrameLayout
        android:id="@+id/computationsHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_circle_outline"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left"
            app:tint="#1A202C" />

        <TextView
            android:id="@+id/computationsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/figtree_bold"
            android:text="@string/computations_title"
            android:textColor="#1A202C"
            android:textSize="22sp" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/computationsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/computationsHeader">

        <LinearLayout
            android:id="@+id/computationsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/computationsBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_computations_banner"
                android:fontFamily="@font/figtree_medium"
                android:lineSpacingExtra="3sp"
                android:padding="16dp"
                android:text="@string/computations_banner"
                android:textColor="#264F36"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/formulaTableHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.40"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="center"
                    android:text="@string/computations_col_category"
                    android:textColor="#1A202C"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.60"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="center"
                    android:text="@string/computations_col_formula"
                    android:textColor="#1A202C"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/formulaTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/disclaimerBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_computations_note"
                android:fontFamily="@font/figtree_medium"
                android:lineSpacingExtra="3sp"
                android:padding="16dp"
                android:text="@string/computations_disclaimer"
                android:textColor="#8A8070"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
