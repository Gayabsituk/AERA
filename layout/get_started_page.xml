<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5"
    tools:context=".GetStartedFragment">

    <!-- Top Logo / Title -->
    <TextView
        android:id="@+id/logoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:drawablePadding="8dp"
        android:fontFamily="@font/figtree_extrabold"
        android:text="@string/aera"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:textColor="#264F36"
        android:textSize="22sp"
        app:drawableStartCompat="@drawable/ic_activity"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center Circular Artwork Background -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/heroImageCard"
        android:layout_width="270dp"
        android:layout_height="270dp"
        android:layout_marginTop="48dp"
        app:cardBackgroundColor="#DDF0E3"
        app:cardCornerRadius="135dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@+id/titleText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoText"
        app:layout_constraintVertical_bias="0.3">

        <!-- Inner Circular Mask -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center"
            app:cardCornerRadius="120dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <!-- The actual image -->
            <ImageView
                android:id="@+id/heroImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/aera"
                android:contentDescription="@string/aera_landscape_illustration" />

        </com.google.android.material.card.MaterialCardView>

    </com.google.android.material.card.MaterialCardView>
    <!-- Main Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:fontFamily="@font/figtree_black"
        android:text="@string/breathe_easy"
        android:textColor="#192E21"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/heroImageCard" />

    <!-- Subtitle Description -->
    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="40dp"
        android:fontFamily="@font/figtree_medium"
        android:lineSpacingExtra="4dp"
        android:text="@string/welcome_to_aera_where_every_choice_counts_every_footprint_matters"
        android:textAlignment="center"
        android:textColor="#7A8F82"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleText"
        tools:ignore="TextContrastCheck" />

    <!-- Bottom Footer Text -->
    <TextView
        android:id="@+id/footerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:fontFamily="@font/figtree_medium"
        android:text="@string/_100_secure_amp_offline"
        android:textColor="#336647"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Get Started Button -->
    <Button
        android:id="@+id/getStartedButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#336647"
        android:fontFamily="@font/figtree_bold"
        android:text="@string/get_started"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toTopOf="@+id/footerText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>